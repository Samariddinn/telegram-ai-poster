# Copy to .env and fill in real values. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://tap:tap@localhost:5432/telegram_ai_poster?schema=public"

# Redis — a plain redis:// (or rediss:// for TLS, e.g. Upstash/Redis Cloud) connection URL.
# Matches docker-compose.yml if running Redis locally: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
INVITE_CODE="change-me"

# Credential encryption (AES-256-GCM key, 32 bytes, base64-encoded)
CREDENTIALS_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# API
API_PORT=3000
